# go-core-kit — example environment (development values).
# Copy to .env for local development; never commit real secrets.

# Deployment environment: dev | staging | prod | test
APP_ENV=dev

# API listen port
HTTP_PORT=8080

# SQLite database file path (required)
DATABASE_PATH=./.data/app.db

# Redis connection URL (required)
REDIS_URL=redis://localhost:6379/0

# Logging: level (debug | info | warn | error) and format (json | text)
LOG_LEVEL=debug
LOG_FORMAT=text

# Auth: token TTLs and password policy
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_MIN_LENGTH=10

# Auth: login rate limiting (attempts per window, block duration)
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_BLOCK_SECONDS=900

# Auth: access-token claims (optional; required in staging/production)
AUTH_ISSUER=
AUTH_AUDIENCE=

# Auth: JWT signing keys as a JWK set (JSON, or base64 of it). Required in
# staging/production; a development environment falls back to an ephemeral key.
AUTH_SIGNING_KEYS_JSON=
AUTH_SIGNING_KEYS_JSON_BASE64=

# Auth: Google OIDC (comma-separated client ids; empty disables OIDC exchange).
# AUTH_OIDC_GOOGLE_JWKS_URL overrides Google's certificate endpoint (testing only).
AUTH_OIDC_GOOGLE_CLIENT_IDS=
AUTH_OIDC_GOOGLE_JWKS_URL=

# Push: gates push token registration until the FCM adapter lands (default false).
PUSH_ENABLED=false

# Worker: probe listener port (the API keeps HTTP_PORT).
WORKER_HTTP_PORT=8081

# Storage: S3-compatible object storage for profile images (empty disables it).
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# Users: profile image upload rate limits (per user, then per IP).
USERS_PROFILE_IMAGE_UPLOAD_USER_MAX_ATTEMPTS=20
USERS_PROFILE_IMAGE_UPLOAD_USER_WINDOW_SECONDS=3600
USERS_PROFILE_IMAGE_UPLOAD_USER_BLOCK_SECONDS=900
USERS_PROFILE_IMAGE_UPLOAD_IP_MAX_ATTEMPTS=60
USERS_PROFILE_IMAGE_UPLOAD_IP_WINDOW_SECONDS=300
USERS_PROFILE_IMAGE_UPLOAD_IP_BLOCK_SECONDS=900
